[Unit]
Description=IR Styleshkon video processing service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ir-styleshkon
EnvironmentFile=/opt/ir-styleshkon/.env
ExecStart=/opt/ir-styleshkon/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=3
User=root
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
